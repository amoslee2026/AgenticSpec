[Unit]
Description=AgenticSpec API（结构化文档知识库）
Documentation=https://github.com/amoslee2026/AgenticSpec
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/lxx/wrk/AgenticSpec

# 环境变量从仓库 .env 加载（含 DATABASE_URL 等；非 systemd 环境变量）
EnvironmentFile=/home/lxx/wrk/AgenticSpec/.env

# 本机 all_proxy=socks5 会破坏 PG/HTTP 连接（TLS handshake 失败），必须清除
Environment=all_proxy=
Environment=ALL_PROXY=
Environment=http_proxy=
Environment=https_proxy=
Environment=ftp_proxy=
Environment=no_proxy=localhost,127.0.0.1,::1

# LAN 访问（ADR-007 S6）：TLS 反代（httpd :443 → 127.0.0.1:8787）终止时，
# 采信 X-Forwarded-Proto（Cookie 自动 Secure）与 X-Forwarded-For（真实客户端限流键）。
# 详见 scripts/provision_lan_tls_httpd.sh
Environment=AUTH_TRUSTED_PROXY=1

# 默认 loopback（安全默认）；对外部署改 --host 0.0.0.0
# 前提（二者缺一不可，ADR-007 S6）：
#   ① 已自举 admin（无 users 行则 fail-closed，全部 401）
#   ② 经 TLS 反向代理终止（否则会话 Cookie 可被嗅探）
ExecStart=/home/lxx/wrk/AgenticSpec/.venv/bin/python -m uvicorn agenticspec.app:create_app \
    --factory --host 127.0.0.1 --port 8787 --log-level info

Restart=on-failure
RestartSec=5s

# 优雅停止
KillSignal=SIGINT
TimeoutStopSec=15

# 加固（最小权限）
NoNewPrivileges=true
PrivateTmp=true
# 注：不用 ProtectSystem=full / ProtectHome=read-only
#   —— 本服务工作目录就在 /home 下且需读写 logs/、data/、build/，
#      这两项会与其冲突（需 ReadWritePaths 逐条豁免，反而更易漏）。
#      单机私有部署下用 PrivateTmp + NoNewPrivileges 已足够。

[Install]
WantedBy=default.target
