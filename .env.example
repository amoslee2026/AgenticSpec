# AgenticSpec 环境变量（本地开发/部署）
# 用法：source 此文件，或由 systemd EnvironmentFile 加载
# 注意：本文件含开发凭据，不入库（.gitignore 已覆盖 .env*）

# 数据库（ADR-002/ADR-007：属主 agenticspec，应用用 agenticspec_app）
DATABASE_URL=postgresql+asyncpg://agenticspec_app:agenticspec_app_dev@127.0.0.1:5432/agenticspec
TEST_DATABASE_URL=postgresql+asyncpg://agenticspec_app:agenticspec_app_dev@127.0.0.1:5432/agenticspec_test
MIGRATION_DATABASE_URL=postgresql+asyncpg://agenticspec:agenticspec_dev@127.0.0.1:5432/agenticspec

# 数据目录（spec §5）
ASSET_STORE_DIR=/home/lxx/wrk/AgenticSpec/data/assets
IMPORT_WORK_DIR=/home/lxx/wrk/AgenticSpec/data/import_work
RENDER_OUT_DIR=/home/lxx/wrk/AgenticSpec/build/rendered
TERMS_SEED=/home/lxx/wrk/AgenticSpec/data/terms_seed.yaml
LOG_DIR=/home/lxx/wrk/AgenticSpec/logs

# 鉴权（ADR-007）
ADMIN_SSH_PUBKEY_FILE=/home/lxx/wrk/AgenticSpec/data/admin_keys/admin.pub
SESSION_TTL_HOURS=8
SIGNATURE_MAX_SKEW_SECONDS=300
AUTH_RATE_LIMIT_PER_MIN=10

# 服务
API_HOST=127.0.0.1
API_PORT=8787
DEV_MODE=0

# 性能（ADR-009/ADR-010）
SLOW_QUERY_MS=200
LOG_RETENTION_DAYS=30
LOG_MAX_MB=500
